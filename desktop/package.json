{
  "name": "opentube-desktop",
  "version": "1.0.0",
  "description": "OpenTube for Windows",
  "author": "OpenTube",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --x64" },
  "devDependencies": { "electron": "^31.7.7", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "com.opentube.desktop",
    "productName": "OpenTube",
    "files": ["main.js", "offline.html", "app-config.json", "icon.png"],
    "win": { "target": ["nsis", "portable"], "icon": "icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "OpenTube-Setup-${version}.exe" },
    "portable": { "artifactName": "OpenTube-Portable-${version}.exe" }
  }
}
